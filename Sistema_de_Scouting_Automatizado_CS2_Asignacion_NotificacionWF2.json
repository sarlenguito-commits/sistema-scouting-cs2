    {
      "parameters": {
        "jsCode": "// 1. Traemos los cupos actuales desde GET CONFIG (referenciado por nombre,\n//    porque el input de este nodo es el Search de candidatos, no GET CONFIG)\nconst cuposOcupados = $('GET CONFIG').first().json.fields['Cupos ocupados'];\nconst cuposTotales = $('GET CONFIG').first().json.fields['Cupos totales'];\nlet disponibles = cuposTotales - cuposOcupados;\n\n// 2. Ordenamos los candidatos aprobados por mérito (KD+Winrate), igual que en el Workflow 1\nconst items = $input.all().sort((a, b) => {\n  const puntajeA = a.json.fields['KD'] + a.json.fields['Winrate'];\n  const puntajeB = b.json.fields['KD'] + b.json.fields['Winrate'];\n  return puntajeB - puntajeA;\n});\n\n// 3. Repartimos cupo a los mejores, mientras haya disponibles\nlet cuposAsignados = 0;\nfor (const item of items) {\n  if (disponibles > 0) {\n    item.json.tieneCupo = true;\n    disponibles--;\n    cuposAsignados++;\n  } else {\n    item.json.tieneCupo = false;\n  }\n}\n\n// 4. Le agregamos a CADA item el nuevo total de Cupos ocupados,\n//    así el nodo Update de Config (más adelante) lo puede leer sin\n//    depender de un nodo separado por fuera del loop\nconst nuevoCuposOcupados = cuposOcupados + cuposAsignados;\nfor (const item of items) {\n  item.json.nuevoCuposOcupados = nuevoCuposOcupados;\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "id": "4b86a61b-2aed-48a1-966b-c58605a545a3",
      "name": "Code in JavaScript"
