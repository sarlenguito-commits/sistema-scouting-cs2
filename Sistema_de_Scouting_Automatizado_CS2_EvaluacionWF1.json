    {
      "parameters": {
        "jsCode": "const cuposOcupados = $('GET CONFIG').first().json.fields['Cupos ocupados'];\nconst cuposTotales = $('GET CONFIG').first().json.fields['Cupos totales'];\nlet disponibles = cuposTotales - cuposOcupados;\n\nconst items = $input.all().sort((a, b) => {\n  const puntajeA = a.json.fields['KD'] + a.json.fields['Winrate'];\n  const puntajeB = b.json.fields['KD'] + b.json.fields['Winrate'];\n  return puntajeB - puntajeA; // orden descendente: mejor puntaje primero\n});\n\nfor (const item of items) {\n  if (disponibles > 0) {\n    item.json.tieneCupo = true;\n    disponibles--;\n  } else {\n    item.json.tieneCupo = false;\n  }\n}\n\nreturn items;"
      },
